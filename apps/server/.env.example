# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/resort_management?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# File Upload (if using local storage)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Email Configuration
EMAIL_FROM="Resort Nirjon <noreply@resortnirjon.com>"

# Admin panel URL (for password reset links)
ADMIN_URL="http://localhost:8001"

# Choose ONE email provider by uncommenting its settings:

# Option 1: Resend (Recommended - 3000 emails/month free)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Option 2: Brevo/Sendinblue (300 emails/day free)
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxx
# BREVO_EMAIL=your-brevo-login-email@example.com

# Option 3: Mailgun (5000 emails/month free for 3 months)
# MAILGUN_API_KEY=xxxxxxxxxxxxxxxxxxxxx
# MAILGUN_SMTP_HOST=smtp.mailgun.org
# MAILGUN_SMTP_USER=postmaster@yourdomain.mailgun.org

# Option 4: SendGrid (100 emails/day free)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# Option 5: Custom SMTP (e.g., Gmail with app password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password