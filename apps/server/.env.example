# ── Server ───────────────────────────────────────────────────────────────────
# Dev wiring: admin (Vite :8001) proxies /api → :8000; web (:3002) calls :8000.
PORT=8000
NODE_ENV=development

# Reverse-proxy hops in front of the API (Coolify/Traefik, nginx = 1) so rate
# limiting and audit logs see the real client IP. Default: 1 in production,
# off in development. Accepts Express forms too ("true", "loopback").
# TRUST_PROXY=1
# Global API cap per signed-in user (or per IP when anonymous); default 600 requests/minute.
# API_RATE_LIMIT_PER_MIN=600
# Login/register attempts per IP per 15 minutes (brute-force guard); default 20.
# AUTH_RATE_LIMIT_PER_15MIN=20

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/resort_management?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ── CORS: comma-separated browser origins (admin panel + public website) ─────
CORS_ORIGIN="http://localhost:8001,http://localhost:3002,http://127.0.0.1:8001,http://127.0.0.1:3002"

# ── URLs embedded in emails / redirects ──────────────────────────────────────
# Admin panel — password-reset links point here.
ADMIN_URL="http://localhost:8001"
# Public website — Stripe success/cancel redirects point here.
WEB_PUBLIC_URL="http://localhost:3002"

# ── Stripe card payments (leave unset to disable card checkout) ──────────────
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
# Signing secret of the webhook that targets POST /api/public/stripe/webhook.
# Without it the webhook returns 400; the /booking/success page still confirms
# paid sessions via GET /api/public/stripe/session/:id.
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ── Email ────────────────────────────────────────────────────────────────────
# Brand used in every template and as the sender name.
RESORT_NAME="Pina Vista"
EMAIL_FROM="Pina Vista <noreply@pinavista.com>"

# Pick ONE transport. Priority when several are set: SMTP → Resend → Brevo.
# With none set, emails are skipped with a warning. The booking OTP is delivered
# ONLY by email (never logged or returned by the API), so one transport must be
# configured to test the public booking flow, in development too.

# Option 1: any SMTP provider (Gmail app password, Mailgun, SendGrid, Postmark…)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Option 2: Resend (3000 emails/month free)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Option 3: Brevo / Sendinblue (300 emails/day free)
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxx
# BREVO_EMAIL=your-brevo-login-email@example.com
