// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ExpenseCategory {
  id         String     @id @default(uuid())
  name       String
  // Link to a chart-of-accounts EXPENSE account (Phase 0.2). Optional during migration.
  accountId  String?
  account    Account?   @relation(fields: [accountId], references: [id])
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  // Array of CategoryField definitions: [{ key, label, type, required, options? }]
  fields     Json?     @default("[]")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  expenses        Expense[]
  pendingPayments PendingPayment[]

  @@index([isActive])
  @@index([sortOrder])
  @@index([accountId])
}

model PendingPayment {
  id            String           @id @default(uuid())
  title         String
  amount        Float
  categoryId    String?
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id])
  dueDate       DateTime
  notes         String?
  // PENDING | PAID | CANCELLED
  status        String           @default("PENDING")
  createdById   String?
  createdBy     User?            @relation(fields: [createdById], references: [id])
  // Loose reference to Expense created when this payment was paid (not enforced FK)
  paidExpenseId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([status, dueDate])
}

model Expense {
  id              String         @id @default(uuid())
  title           String
  amount          Float
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  date            DateTime
  paymentMethod   PaymentMethod?  @default(CASH)
  paidTo          String?
  description    String?
  attachment     String?
  status         String         @default("PAID")
  createdById     String?
  createdBy       User?          @relation(fields: [createdById], references: [id])
  // Structured values for the category's custom fields: { [fieldKey]: value }
  metadata        Json?
  // Optional link to a StaffSalary row when this expense was auto-created from a salary payment.
  // Lets reports reconcile salary payouts shown in /expenditures back to /staff-salaries without double-counting.
  salaryId        String?        @unique
  salary          StaffSalary?   @relation(fields: [salaryId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
  @@index([date])
  @@index([status])
  @@index([status, date])
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(RECEPTIONIST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  restaurantOrders  RestaurantOrder[]
  createdBookings   Booking[]           @relation("StaffBookings")
  expenses          Expense[]
  salaryPayments    StaffSalary[]
  pendingPayments   PendingPayment[]
  passwordResets    PasswordReset[]
  dayLongBookings   DayLongBooking[]
  stockMovements    StockMovement[]
  accountTransactions AccountTransaction[]
  shareholder       Shareholder?
  createdDistributions ProfitDistribution[]
  staffProfile      StaffProfile?
  markedAttendance  Attendance[]         @relation("AttendanceMarkedBy")
  approvedLeaves    Leave[]              @relation("LeaveApprovedBy")

  @@index([email])
  @@index([role])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model StaffSalary {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  amount       Float
  month        Int        // 1-12
  year         Int
  paymentDate  DateTime?
  status       String     @default("PENDING")
  notes        String?
  // Mirror Expense entry created when status -> PAID. Optional: not present until paid for the first time.
  expense      Expense?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
  @@index([year, month])
}

model Room {
  id          String   @id @default(uuid())
  name        String
  roomCode    String?
  type        RoomType
  price       Float
  weekendPrice Float?
  seasonalPrice Float?
  extraGuestCharge Float?
  status      RoomStatus @default(AVAILABLE)
  capacity    Int
  floorBuilding String?
  roomSizeSqft Int?
  maxAdults   Int?
  maxChildren Int?
  bedType     String?
  description String?
  mainImage   String?
  images      String[]
  facilities  Json?
  foodOptions Json?
  services    Json?
  experienceFeatures Json?
  addOns      Json?
  bookingRules Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  bookings    Booking[]
  orders      RestaurantOrder[]

  @@index([type])
  @@index([status])
  @@index([price])
}

model Booking {
  id            String   @id @default(uuid())
  roomId        String
  guestId       String
  staffId       String?
  adults        Int      @default(1)
  children      Int      @default(0)
  checkInDate   DateTime
  checkOutDate  DateTime
  status        BookingStatus @default(PENDING)
  preferredPaymentTiming String?
  preferredPaymentMethod String?
  paymentTransactionId String?
  paymentProofImage String?
  totalAmount   Float
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  room          Room     @relation(fields: [roomId], references: [id])
  guest         Guest    @relation(fields: [guestId], references: [id])
  staff         User?    @relation("StaffBookings", fields: [staffId], references: [id])
  payments      Payment[]

  @@index([roomId])
  @@index([guestId])
  @@index([status])
  @@index([checkInDate, checkOutDate])
}

model Guest {
  id          String   @id @default(uuid())
  name        String
  phone       String
  nid         String?
  passport    String?
  address     String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  bookings    Booking[]

  @@index([phone])
}

model Payment {
  id            String   @id @default(uuid())
  bookingId     String?
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  notes         String?
  // Polymorphic reference (Phase 0.4). For non-room payments bookingId is null.
  // referenceType: "BOOKING" | "RESTAURANT_ORDER" | "DAY_LONG_BOOKING"
  referenceType String?
  referenceId   String?
  businessLine  BusinessLine?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  booking       Booking?  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([method])
  @@index([status])
  @@index([stripeSessionId])
  @@index([referenceType, referenceId])
  @@index([businessLine])
}

model RestaurantMenu {
  id          String   @id @default(uuid())
  name        String
  price       Float
  category    String
  description String?
  image       String?
  isAvailable Boolean  @default(true)
  // Display order inside category (then name). Lower = earlier in menu book.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients MenuItemIngredient[]

  @@index([category])
  @@index([category, sortOrder])
  @@index([isAvailable])
}

model RestaurantOrder {
  id          String   @id @default(uuid())
  roomId      String?
  userId      String?
  items       Json
  totalPrice  Float
  discount      Float   @default(0)
  serviceCharge Float   @default(0)
  netAmount     Float?  // totalPrice - discount + serviceCharge (computed on write)
  paidAmount    Float   @default(0)
  paymentStatus RestaurantOrderPaymentStatus @default(UNPAID)
  businessLine  BusinessLine @default(RESTAURANT)
  status      OrderStatus @default(PENDING)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  room         Room?    @relation(fields: [roomId], references: [id])
  user         User?    @relation(fields: [userId], references: [id])

  @@index([roomId])
  @@index([status])
  @@index([paymentStatus])
}

model Setting {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String
  description   String?
  type          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([key])
}

// Public site gallery — admin: image URL or data URL, category & sort order.
model SiteGalleryItem {
  id          String   @id @default(uuid())
  imageUrl    String
  alt         String   @default("")
  category    String   @default("General")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([category])
}

// Home “nearby places” carousel + /explore/[slug] detail — managed in admin.
model SiteNearbySpot {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  emoji       String   @default("")
  badge       String   @default("")
  distance    String   @default("")
  bullets     String[] @default([])
  bestFor     String   @default("")
  imageUrl    String
  imageAlt    String   @default("")
  body        String   @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Blog posts — managed in admin, displayed on web.
model SiteBlog {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  summary    String   @db.Text // Short description for card
  content     String   @db.Text // Full blog body (markdown/HTML)
  imageUrl    String
  imageAlt    String   @default("")
  category    String   @default("General")
  authorName  String   @default("Nirjon Nature's Hideout")
  tags        String[] @default([])
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([category])
}

// Chart of Accounts (Phase 0.1). Hierarchical tree of accounts.
model Account {
  id             String      @id @default(uuid())
  code           String      @unique   // e.g., "1001", "4002"
  name           String
  type           AccountType
  parentId       String?
  parent         Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       Account[]   @relation("AccountHierarchy")
  description    String?
  openingBalance Float       @default(0)
  currentBalance Float       @default(0)
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  expenseCategories ExpenseCategory[]
  transactions      AccountTransaction[]

  @@index([type])
  @@index([parentId])
  @@index([code])
}

enum TxnDirection {
  IN    // money into this account   → balance += amount
  OUT   // money out of this account  → balance -= amount
}

enum ReceivableStatus {
  OPEN
  PARTIAL
  COLLECTED
  CANCELLED
}

// Amount owed TO the resort (unpaid booking/order balances, other debts).
model Receivable {
  id              String           @id @default(uuid())
  customerName    String
  amount          Float
  collectedAmount Float            @default(0)
  dueDate         DateTime?
  status          ReceivableStatus @default(OPEN)
  referenceType   String?          // BOOKING | RESTAURANT_ORDER | DAY_LONG_BOOKING | OTHER
  referenceId     String?
  notes           String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([referenceType, referenceId])
}

// Signed cashbook ledger entry (Phase 4). One uniform rule: IN adds, OUT subtracts.
model AccountTransaction {
  id              String        @id @default(uuid())
  accountId       String
  account         Account       @relation(fields: [accountId], references: [id])
  direction       TxnDirection
  amount          Float         // always positive
  description     String?
  businessLine    BusinessLine?
  referenceType   String?       // BOOKING | RESTAURANT_ORDER | DAY_LONG_BOOKING | EXPENSE | TRANSFER | INVOICE | DISTRIBUTION
  referenceId     String?
  transactionDate DateTime      @default(now())
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([accountId])
  @@index([transactionDate])
  @@index([businessLine])
  @@index([referenceType, referenceId])
}

// Booking OTP persisted to DB (Phase 0.6) — replaces in-memory Map in publicController.
model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([email, code])
  @@index([expiresAt])
}

// ── Day Long module (Phase 1) ──────────────────────────────────────────────
enum DayLongCategory {
  POOL
  COTTAGE
  CONFERENCE
  EVENT
  PICNIC
}

enum DayLongBookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model DayLongProduct {
  id             String          @id @default(uuid())
  name           String
  category       DayLongCategory
  description    String?
  images         String[]
  basePrice      Float           // per-slot / base rate
  pricePerPerson Float?          // optional per-person charge
  maxCapacity    Int?
  minCapacity    Int?
  facilities     Json?           // ["Shower", "Changing Room", ...]
  availableSlots Json?           // [{ start, end, label }]
  duration       Int?            // default hours
  bookingRules   Json?
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  bookings       DayLongBooking[]

  @@index([category])
  @@index([isActive, sortOrder])
}

model DayLongBooking {
  id                     String               @id @default(uuid())
  productId              String
  product                DayLongProduct       @relation(fields: [productId], references: [id])
  guestName              String
  guestPhone             String
  guestEmail             String?
  guestNid               String?
  guestAddress           String?
  bookingDate            DateTime
  slotStart              String
  slotEnd                String
  adults                 Int                  @default(1)
  children               Int                  @default(0)
  totalAmount            Float
  paidAmount             Float                @default(0)
  status                 DayLongBookingStatus @default(PENDING)
  notes                  String?
  preferredPaymentTiming String?              // INSTANT | LATER
  preferredPaymentMethod String?
  paymentTransactionId   String?
  paymentProofImage      String?
  createdById            String?
  createdBy              User?                @relation(fields: [createdById], references: [id])
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([productId])
  @@index([bookingDate])
  @@index([status])
  @@index([bookingDate, status])
}

enum Role {
  SUPER_ADMIN
  MANAGER
  RECEPTIONIST
  HOUSEKEEPING
  RESTAURANT_STAFF
  ACCOUNTANT
  SHAREHOLDER
}

// ── Shareholder module (Phase 5) ───────────────────────────────────────────
enum ShareType {
  PERCENTAGE   // gets X% of the distributable pool (relative to other percentage holders)
  FIXED        // gets a fixed amount per distribution
  CUSTOM       // admin sets amount manually per distribution
}

enum DistributionStatus {
  DRAFT
  APPROVED
  DISTRIBUTED
  CANCELLED
}

enum ProfitShareStatus {
  PENDING
  PAID
  CANCELLED
}

model Shareholder {
  id               String    @id @default(uuid())
  userId           String?   @unique
  user             User?     @relation(fields: [userId], references: [id])
  name             String
  phone            String
  email            String?   @unique
  address          String?
  nid              String?
  shareType        ShareType @default(PERCENTAGE)
  shareValue       Float     @default(0)   // percentage number OR fixed amount
  totalShares      Int?
  investmentAmount Float?
  joinDate         DateTime  @default(now())
  isActive         Boolean   @default(true)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profitShares     ProfitShare[]

  @@index([email])
  @@index([isActive])
}

model ProfitDistribution {
  id               String             @id @default(uuid())
  periodLabel      String
  periodStart      DateTime
  periodEnd        DateTime
  totalProfit      Float
  totalDistributed Float              @default(0)
  distributionDate DateTime?
  status           DistributionStatus @default(DRAFT)
  notes            String?
  createdById      String?
  createdBy        User?              @relation(fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  shares           ProfitShare[]

  @@index([status])
  @@index([periodStart, periodEnd])
}

model ProfitShare {
  id             String             @id @default(uuid())
  distributionId String
  distribution   ProfitDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  shareholderId  String
  shareholder    Shareholder        @relation(fields: [shareholderId], references: [id])
  amount         Float
  status         ProfitShareStatus  @default(PENDING)
  paidDate       DateTime?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([distributionId, shareholderId])
  @@index([shareholderId])
  @@index([status])
}

// ── Inventory module (Phase 3) ─────────────────────────────────────────────
enum InventoryCategory {
  FOOD_ITEM
  AMENITY
  PRODUCT
  SUPPLY
  ASSET
}

enum StockMoveType {
  PURCHASE      // stock in (buy)
  SALE          // stock out (sold directly)
  CONSUMPTION   // stock out (used by restaurant order / day-long)
  ISSUE         // stock out (housekeeping/amenity issue)
  ADJUSTMENT    // manual +/- (correction, wastage)
  RETURN        // stock in (return/supplier reversal)
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     InventoryItem[]
  purchases StockMovement[]

  @@index([isActive])
}

model InventoryItem {
  id                 String            @id @default(uuid())
  sku                String?           @unique
  name               String
  category           InventoryCategory
  unit               String            // "kg", "pcs", "litre", "box"
  currentStock       Float             @default(0)
  reorderLevel       Float             @default(0)
  costPrice          Float             @default(0)   // last purchase unit cost
  sellPrice          Float?
  supplierId         String?
  supplier           Supplier?         @relation(fields: [supplierId], references: [id])
  expenseAccountCode String?           // which account a purchase hits (default by category)
  isActive           Boolean           @default(true)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  movements  StockMovement[]
  menuLinks  MenuItemIngredient[]

  @@index([category])
  @@index([isActive])
  @@index([currentStock])
}

model StockMovement {
  id            String        @id @default(uuid())
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id])
  type          StockMoveType
  quantity      Float         // always positive; sign implied by type
  unitCost      Float?
  totalCost     Float?
  balanceAfter  Float         // stock snapshot after this move
  supplierId    String?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  referenceType String?       // "RESTAURANT_ORDER" | "DAY_LONG_BOOKING" | "PURCHASE" | "MANUAL"
  referenceId   String?
  expenseId     String?       // link to created Expense (for PURCHASE)
  notes         String?
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([itemId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

// Recipe link: a menu item consumes N units of an inventory food-item.
model MenuItemIngredient {
  id         String         @id @default(uuid())
  menuItemId String
  menuItem   RestaurantMenu @relation(fields: [menuItemId], references: [id])
  itemId     String
  item       InventoryItem  @relation(fields: [itemId], references: [id])
  quantity   Float          // units consumed per 1 menu item sold
  createdAt  DateTime       @default(now())

  @@unique([menuItemId, itemId])
  @@index([menuItemId])
}

enum RoomType {
  STANDARD
  DELUXE
  SUITE
  FAMILY
  PRESIDENTIAL
}

// ── Staff HR module (Phase 6) ──────────────────────────────────────────────
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum LeaveType {
  SICK
  CASUAL
  ANNUAL
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Department {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  designations Designation[]
  staff        StaffProfile[]

  @@index([isActive])
}

model Designation {
  id           String       @id @default(uuid())
  title        String
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id])
  sortOrder    Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  staff        StaffProfile[]

  @@unique([title, departmentId])
  @@index([departmentId])
}

model StaffProfile {
  id               String       @id @default(uuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id])
  employeeId       String?      @unique
  departmentId     String?
  department       Department?  @relation(fields: [departmentId], references: [id])
  designationId    String?
  designation      Designation? @relation(fields: [designationId], references: [id])
  phone            String?
  emergencyContact String?
  emergencyPhone   String?
  presentAddress   String?
  permanentAddress String?
  bloodGroup       String?
  dateOfBirth      DateTime?
  joiningDate      DateTime?
  resignDate       DateTime?
  bankName         String?
  bankAccountNo    String?
  bankBranch       String?
  basicSalary      Float?
  isActive         Boolean      @default(true)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  dutyRosters      DutyRoster[]
  attendance       Attendance[]
  leaves           Leave[]

  @@index([departmentId])
  @@index([designationId])
  @@index([isActive])
}

model Shift {
  id          String       @id @default(uuid())
  name        String
  startTime   String
  endTime     String
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  dutyRosters DutyRoster[]

  @@index([isActive])
}

model DutyRoster {
  id        String       @id @default(uuid())
  staffId   String
  staff     StaffProfile @relation(fields: [staffId], references: [id])
  shiftId   String
  shift     Shift        @relation(fields: [shiftId], references: [id])
  date      DateTime
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([staffId, date])
  @@index([date])
  @@index([shiftId])
}

model Attendance {
  id         String           @id @default(uuid())
  staffId    String
  staff      StaffProfile     @relation(fields: [staffId], references: [id])
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  markedById String?
  markedBy   User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([staffId, date])
  @@index([date])
  @@index([status])
  @@index([staffId, date])
}

model Leave {
  id              String       @id @default(uuid())
  staffId         String
  staff           StaffProfile @relation(fields: [staffId], references: [id])
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  reason          String?
  status          LeaveStatus  @default(PENDING)
  approvedById    String?
  approvedBy      User?        @relation("LeaveApprovedBy", fields: [approvedById], references: [id])
  rejectionReason String?
  documents       String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([staffId])
  @@index([status])
  @@index([startDate, endDate])
}

