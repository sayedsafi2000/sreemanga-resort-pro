# Public site (apps/web)
NEXT_PUBLIC_SITE_URL=https://web.pixelsbee.com

# Always use server API (no frontend dummy fallback).
NEXT_PUBLIC_USE_DUMMY_API=false

# Backend public API base (no trailing slash). Must match routes mounted at /api/public on the server.
NEXT_PUBLIC_API_URL=https://app.pixelsbee.com/api/public
