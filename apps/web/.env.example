# Public site (apps/web)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Always use server API (no frontend dummy fallback).
NEXT_PUBLIC_USE_DUMMY_API=false

# Backend public API base (no trailing slash). Must match routes mounted at /api/public on the server.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/public

# Server-side only (Next.js SSR inside Docker). Browser still uses NEXT_PUBLIC_API_URL.
# Example for docker-compose.dev: http://api:8000/api/public
# INTERNAL_API_URL=http://api:8000/api/public

# Optional fallbacks for the payment details shown on the booking page.
# Admin → Settings → Payment Accounts takes precedence. Leave unset to show a
# "please call us" note instead of a number.
# NEXT_PUBLIC_BKASH_NUMBER=
# NEXT_PUBLIC_NAGAD_NUMBER=
# NEXT_PUBLIC_BANK_NAME=
# NEXT_PUBLIC_BANK_BRANCH=
# NEXT_PUBLIC_BANK_ACCOUNT_NAME=
# NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
