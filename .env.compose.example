# Local stand-ins for the values Coolify generates automatically. Copy to .env for
#   docker compose -f docker-compose.yml -f docker-compose.local.yml --env-file .env up --build
SERVICE_USER_POSTGRES=resort
SERVICE_PASSWORD_POSTGRES=resort-local-password
SERVICE_PASSWORD_64_JWT=local-dev-jwt-secret-change-me-0123456789abcdef0123456789abcdef
SERVICE_URL_SERVER=http://localhost:8000
SERVICE_URL_ADMIN=http://localhost:3003
SERVICE_URL_WEB=http://localhost:3002
POSTGRES_DB=resort_management
