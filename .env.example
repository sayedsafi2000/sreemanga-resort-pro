# ── Server environment (apps/server/.env) ──────────────────────────────────
# Copy to apps/server/.env and fill in. .env files are gitignored.

# Required
DATABASE_URL=postgresql://resort:resort@localhost:5432/resort_management?schema=public
JWT_SECRET=change-me-to-a-long-random-string
PORT=8000
# Comma-separated allowed origins for CORS (admin + web dev ports)
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:8001

# Optional
JWT_EXPIRES_IN=7d
ADMIN_URL=http://localhost:8001        # used to build password-reset links
NODE_ENV=development

# ── Email (all optional; picked in priority order by utils/emailService.ts) ──
# Option A: any SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Option B: Resend
RESEND_API_KEY=
# Option C: Brevo
BREVO_API_KEY=
BREVO_EMAIL=
# Branding on every email
RESORT_NAME=Pina Vista
EMAIL_FROM=no-reply@example.com

# ── Payments (optional) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Web public vars (apps/web/.env.local — NEXT_PUBLIC_* shown to guests) ────
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/public
# NEXT_PUBLIC_SITE_URL=http://localhost:3002
# NEXT_PUBLIC_BKASH_NUMBER=
# NEXT_PUBLIC_BANK_NAME=
# NEXT_PUBLIC_BANK_ACCOUNT_NAME=
# NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
# NEXT_PUBLIC_BANK_BRANCH=

# ── Admin vars (apps/admin/.env) ────────────────────────────────────────────
# VITE_API_URL=http://localhost:8000/api
